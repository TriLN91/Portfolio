# Copy to .env (never commit .env). Values used by docker-compose and Render.

# --- Database (Neon example: copy host/db from the Neon dashboard) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/portfolio
DATABASE_USERNAME=portfolio
DATABASE_PASSWORD=portfolio
# Neon: DATABASE_URL=jdbc:postgresql://ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# --- Frontend URLs allowed to call the API (comma-separated) ---
APP_CORS_ORIGINS=http://localhost:5173

# --- Email notifications for the contact form ---
# Local: Mailpit from docker-compose (open http://localhost:8025 to see emails)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
# Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USERNAME=you@gmail.com,
#        MAIL_PASSWORD=<16-character App Password>, MAIL_SMTP_AUTH=true, MAIL_STARTTLS=true
CONTACT_NOTIFY_TO=your.email@gmail.com
CONTACT_FROM=your.email@gmail.com
CONTACT_IP_SALT=put-any-random-text-here

# --- GitHub stats ---
GITHUB_USERNAME=your-username
# Optional: a token without any scopes raises the rate limit from 60 to 5000 requests/hour
GITHUB_TOKEN=
